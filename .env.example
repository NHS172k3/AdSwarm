# Core app
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=low
PAYMENT_MODE=mock

# Optional: Supabase audit log
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: on-chain demo mode (Base Sepolia)
TREASURY_PRIVATE_KEY=0xyour-treasury-private-key
TREASURY_ADDRESS=0xyour-treasury-address
RPC_URL=https://base-sepolia.g.alchemy.com/v2/your-alchemy-key
USDC_ADDRESS=0xyour-base-sepolia-usdc-address

# Optional: wallet connect for fund/deposit UI
NEXT_PUBLIC_WALLETCONNECT_ID=your-walletconnect-project-id

# Optional: real x402 / facilitator setup if you choose to wire it later
CDP_API_KEY_ID=your-cdp-key-id
CDP_API_KEY_SECRET=your-cdp-key-secret

# Optional: non-blocking video artifact provider hook
VIDEO_PROVIDER=manual
VIDEO_TIMEOUT_MS=180000
OPENAI_EXPERIMENTAL_VIDEO_ENABLED=true
OPENAI_EXPERIMENTAL_VIDEO_MODEL=sora-2
# OPENAI_EXPERIMENTAL_VIDEO_BASE_URL=https://api.openai.com/v1
# OPENAI_EXPERIMENTAL_VIDEO_POLL_INTERVAL_MS=10000
# OPENAI_EXPERIMENTAL_VIDEO_POLL_TIMEOUT_MS=300000

# Optional: future sovereign-agent mode
# STRATEGIST_PRIVATE_KEY=0x...
# COPYWRITER_PRIVATE_KEY=0x...
# DESIGNER_PRIVATE_KEY=0x...
# MEDIABUYER_PRIVATE_KEY=0x...
